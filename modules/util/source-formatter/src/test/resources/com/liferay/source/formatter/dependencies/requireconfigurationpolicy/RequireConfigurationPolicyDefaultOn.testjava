package com.liferay.source.formatter.dependencies.requireconfigurationpolicy;

import com.liferay.portal.configuration.metatype.bnd.util.ConfigurableUtil;
import com.liferay.portal.requireconfigurationpolicy.DefaultOnConfiguration;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Modified;

/**
 * @author Shuyang Zhou
 */
@Component(
	configurationPid = "com.liferay.portal.requireconfigurationpolicy.DefaultOnConfiguration",
	service = {}
)
public class RequireConfigurationPolicyDefaultOn {

	public void track(String url) {
		if (!_defaultOnConfiguration.enabled() || (url == null)) {
			return;
		}

		_urls.add(url);
	}

	@Activate
	@Modified
	protected void activate(Map<String, Object> properties) {
		_defaultOnConfiguration = ConfigurableUtil.createConfigurable(
			DefaultOnConfiguration.class, properties);
	}

	private volatile DefaultOnConfiguration _defaultOnConfiguration;
	private final List<String> _urls = new ArrayList<>();

}