package com.liferay.source.formatter.dependencies.requireconfigurationpolicy;

import com.liferay.portal.requireconfigurationpolicy.BaseProvider;

import org.osgi.service.component.annotations.Component;

/**
 * @author Shuyang Zhou
 */
@Component(
	configurationPid = "com.liferay.portal.requireconfigurationpolicy.EnabledConfiguration",
	service = {}
)
public class RequireConfigurationPolicyInheritedBehavior extends BaseProvider {

	public boolean isAvailable() {
		return enabledConfiguration.enabled();
	}

}