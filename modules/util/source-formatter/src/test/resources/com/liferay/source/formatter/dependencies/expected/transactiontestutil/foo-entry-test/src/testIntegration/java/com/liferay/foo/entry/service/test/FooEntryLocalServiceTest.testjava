package com.liferay.foo.entry.service.test;

import com.liferay.foo.entry.model.FooEntry;
import com.liferay.foo.entry.service.persistence.FooEntryUtil;
import com.liferay.portal.kernel.test.util.TestPropsValues;
import com.liferay.portal.kernel.test.util.TransactionTestUtil;

import java.util.List;

import org.junit.Assert;
import org.junit.Test;

/**
 * @author Shuyang Zhou
 */
public class FooEntryLocalServiceTest {

	@Test
	public void testAddFooEntry() throws Exception {
		long groupId = TestPropsValues.getGroupId();

		List<FooEntry> fooEntries = TransactionTestUtil.invoke(
			FooEntryUtil.getPersistence(),
			fooEntryPersistence -> fooEntryPersistence.findByGroupId(groupId));

		Assert.assertEquals(fooEntries.toString(), 1, fooEntries.size());
	}

}