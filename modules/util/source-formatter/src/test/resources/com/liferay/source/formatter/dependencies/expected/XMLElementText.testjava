package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.xml.Document;
import com.liferay.portal.kernel.xml.Element;
import com.liferay.portal.kernel.xml.SAXReader;
import com.liferay.portal.kernel.xml.XMLUtil;

/**
 * @author Shuyang Zhou
 */
public class XMLElementText {

	public XMLElementText(SAXReader saxReader) {
		_saxReader = saxReader;
	}

	public String[] getAssetEntry(String assetEntryXml) throws Exception {
		String assetEntryType = XMLUtil.getElementText(
			assetEntryXml, "asset-entry-type");

		String assetEntryUuid = XMLUtil.getElementText(
			assetEntryXml, "asset-entry-uuid");

		return new String[] {assetEntryType, assetEntryUuid};
	}

	public String getProductId(String catalogEntryXml) throws Exception {
		return XMLUtil.getElementText(catalogEntryXml, "product-id");
	}

	public String getValidatedAssetEntryUuid(String assetEntryXml)
		throws Exception {

		Document document = _saxReader.read(assetEntryXml, true);

		Element rootElement = document.getRootElement();

		return rootElement.elementText("asset-entry-uuid");
	}

	private final SAXReader _saxReader;

}