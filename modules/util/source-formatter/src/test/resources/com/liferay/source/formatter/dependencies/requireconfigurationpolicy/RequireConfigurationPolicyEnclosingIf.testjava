package com.liferay.source.formatter.dependencies.requireconfigurationpolicy;

import com.liferay.portal.configuration.metatype.bnd.util.ConfigurableUtil;
import com.liferay.portal.requireconfigurationpolicy.DebugEnabledConfiguration;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Modified;

/**
 * @author Shuyang Zhou
 */
@Component(
	configurationPid = "com.liferay.portal.requireconfigurationpolicy.DebugEnabledConfiguration",
	service = {}
)
public class RequireConfigurationPolicyEnclosingIf {

	public void log(String message) {
		if (_debugEnabled && (message != null)) {
			_messages.add(message);
		}
	}

	@Activate
	@Modified
	protected void activate(Map<String, Object> properties) {
		DebugEnabledConfiguration debugEnabledConfiguration =
			ConfigurableUtil.createConfigurable(
				DebugEnabledConfiguration.class, properties);

		_debugEnabled = debugEnabledConfiguration.debugEnabled();
	}

	private volatile boolean _debugEnabled;
	private final List<String> _messages = new ArrayList<>();

}