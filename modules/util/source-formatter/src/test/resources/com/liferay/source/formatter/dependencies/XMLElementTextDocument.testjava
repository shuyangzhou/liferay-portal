package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.xml.Document;
import com.liferay.portal.kernel.xml.Element;
import com.liferay.portal.kernel.xml.SAXReaderUtil;

import java.io.File;

import java.util.ArrayList;
import java.util.List;

/**
 * @author Shuyang Zhou
 */
public class XMLElementTextDocument {

	public String getAssetEntryType(String assetEntryXml) throws Exception {
		Document document = SAXReaderUtil.read(assetEntryXml);

		Element rootElement = document.getRootElement();

		return rootElement.attributeValue("asset-entry-type");
	}

	public String getAssetEntryUuid(File assetEntryFile) throws Exception {
		Document document = SAXReaderUtil.read(assetEntryFile);

		Element rootElement = document.getRootElement();

		return rootElement.elementText("asset-entry-uuid");
	}

	public List<String> getAssetEntryUuids(String assetEntriesXml)
		throws Exception {

		Document document = SAXReaderUtil.read(assetEntriesXml);

		Element rootElement = document.getRootElement();

		List<String> assetEntryUuids = new ArrayList<>();

		for (Element assetEntryElement : rootElement.elements("asset-entry")) {
			assetEntryUuids.add(
				assetEntryElement.elementText("asset-entry-uuid"));
		}

		return assetEntryUuids;
	}

	public String getTrimmedAssetEntryUuid(String assetEntryXml)
		throws Exception {

		Document document = SAXReaderUtil.read(assetEntryXml);

		Element rootElement = document.getRootElement();

		return rootElement.elementTextTrim("asset-entry-uuid");
	}

	public String getValidatedAssetEntryUuid(String assetEntryXml)
		throws Exception {

		Document document = SAXReaderUtil.read(assetEntryXml, true);

		Element rootElement = document.getRootElement();

		return rootElement.elementText("asset-entry-uuid");
	}

}