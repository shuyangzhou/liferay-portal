<%@ include file="/init.jsp" %>

<%
Entry entry = (Entry)request.getAttribute("entry");
%>

<span><%= BeanParamUtil.getLong(entry, request, "entryId", Entry::getEntryId) %></span>
<span><%= BeanParamUtil.getBoolean(entry, request, "active", Entry::isActive, true) %></span>
<span><%= BeanParamUtil.getString(entry, request, "title", Entry::getTitle) %></span>
<span><%= BeanParamUtil.getString(entry, request, "version") %></span>

<%!
private static class Entry {

	public boolean getActive() {
		return true;
	}

	public long getEntryId() {
		return 0;
	}

	public String getTitle() {
		return null;
	}

	public boolean isActive() {
		return true;
	}

}
%>