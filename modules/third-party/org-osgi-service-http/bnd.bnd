Bundle-Description: Includes Http Service packages from the OSGi Compendium specification.
Bundle-SymbolicName: org.osgi.service.http
Bundle-Version: 3.5.0-20150611.165350-3.LIFERAY-PATCHED-1
Export-Package:\
	org.osgi.service.http,\
	org.osgi.service.http.context,\
	org.osgi.service.http.runtime,\
	org.osgi.service.http.runtime.dto,\
	org.osgi.service.http.whiteboard
Include-Resource: @lib/org.eclipse.osgi.services.jar!/org/osgi/service/http/**
Liferay-Releng-Module-Group-Description:
Liferay-Releng-Module-Group-Title: Remote Service Engines
-include: ../../../marketplace/platform/bnd.bnd