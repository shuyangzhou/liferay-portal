Bundle-SymbolicName: org.apache.felix.eventadmin
Bundle-Version: 1.5.0.LIFERAY-PATCHED-1
Import-Package:\
	org.osgi.framework;version="[1.8,2)",\
	org.osgi.service.cm;version="[1.2,2)";resolution:=optional,\
	org.osgi.service.event;version="[1.4,1.5)",\
	org.osgi.service.log;version="[1.3,2)";resolution:=optional,\
	org.osgi.service.metatype;version="[1.1,2)";resolution:=optional,\
	org.osgi.util.tracker;version="[1.5,2)"
Provide-Capability:\
	osgi.implementation;\
		osgi.implementation="osgi.event";\
		uses:="org.osgi.service.event";\
		version:Version="1.4",\
	osgi.service;\
		objectClass:List<String>="org.osgi.service.event.EventAdmin";\
		uses:="org.osgi.service.event"