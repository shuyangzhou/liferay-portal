{
	"compilerOptions": {
		"declaration": true,
		"downlevelIteration": true,
		"esModuleInterop": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"target": "es2017",
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}