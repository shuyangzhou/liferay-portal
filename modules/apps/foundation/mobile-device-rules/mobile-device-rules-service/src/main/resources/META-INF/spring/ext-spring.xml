<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean class="com.liferay.mobile.device.rules.internal.permission.MDRPortletPermissionChecker" id="com.liferay.mobile.device.rules.internal.permission.MDRPortletPermissionChecker" />
	<bean class="com.liferay.mobile.device.rules.internal.permission.MDRRuleGroupInstancePermissionCheckerFactory" factory-method="create" id="com.liferay.mobile.device.rules.internal.permission.MDRRuleGroupInstancePermissionChecker">
		<constructor-arg ref="com.liferay.mobile.device.rules.service.MDRRuleGroupInstanceLocalService" />
		<constructor-arg ref="com.liferay.mobile.device.rules.internal.permission.MDRPortletPermissionChecker" />
	</bean>
	<bean class="com.liferay.mobile.device.rules.internal.permission.MDRRuleGroupPermissionCheckerFactory" factory-method="create" id="com.liferay.mobile.device.rules.internal.permission.MDRRuleGroupPermissionChecker">
		<constructor-arg ref="com.liferay.mobile.device.rules.service.MDRRuleGroupLocalService" />
		<constructor-arg ref="com.liferay.mobile.device.rules.internal.permission.MDRPortletPermissionChecker" />
	</bean>
</beans>