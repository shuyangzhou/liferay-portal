<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean class="com.liferay.microblogs.internal.permission.MicroblogsEntryPermissionChecker" factory-method="create" id="com.liferay.microblogs.internal.permission.MicroblogsEntryPermissionChecker" >
		<constructor-arg ref="com.liferay.microblogs.service.MicroblogsEntryLocalService" />
		<constructor-arg ref="com.liferay.microblogs.internal.permission.MicroblogsPortletPermissionChecker" />
	</bean>
	<bean class="com.liferay.microblogs.internal.permission.MicroblogsPortletPermissionChecker" id="com.liferay.microblogs.internal.permission.MicroblogsPortletPermissionChecker" />
</beans>