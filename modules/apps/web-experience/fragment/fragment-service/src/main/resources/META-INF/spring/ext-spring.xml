<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean class="com.liferay.fragment.internal.permission.FragmentCollectionPermissionCheckerFactory" factory-method="create" id="com.liferay.fragment.internal.permission.FragmentCollectionPermissionChecker" >
		<constructor-arg ref="com.liferay.fragment.service.FragmentCollectionLocalService" />
		<constructor-arg ref="com.liferay.fragment.service.internal.permission.FragmentPortletPermissionChecker" />
	</bean>
	<bean class="com.liferay.fragment.internal.permission.FragmentEntryPermissionCheckerFactory" factory-method="create" id="com.liferay.fragment.internal.permission.FragmentEntryPermissionChecker" >
		<constructor-arg ref="com.liferay.fragment.service.FragmentEntryLocalService" />
		<constructor-arg ref="com.liferay.fragment.service.internal.permission.FragmentPortletPermissionChecker" />
	</bean>
	<bean class="com.liferay.fragment.internal.permission.FragmentPortletPermissionChecker" id="com.liferay.fragment.service.internal.permission.FragmentPortletPermissionChecker" />
</beans>