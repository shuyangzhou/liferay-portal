Bundle-Name: Liferay Wiki Editor Link Browse Web
Bundle-SymbolicName: com.liferay.wiki.editor.link.browse.web
Bundle-Version: 3.0.5
Provide-Capability:\
	alloyeditor.link.browse;\
		alloyeditor.link.browse:String="wiki-attachment-link"
Require-Capability:\
	alloyeditor.link.browse;\
		filter:="(alloyeditor.link.browse=default)"
Web-ContextPath: /wiki-editor-link-browse-web
-dsannotations-options: inherit