<?xml version="1.0"?>

<beans
	default-destroy-method="destroy"
	default-init-method="afterPropertiesSet"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
>
	<bean class="com.liferay.portal.model.adapter.builder.StagedGroupModelAdapterBuilder" id="com.liferay.portal.model.adapter.builder.StagedGroupModelAdapterBuilder" />
	<bean class="com.liferay.portal.model.adapter.builder.StagedThemeModelAdapterBuilder" id="com.liferay.portal.model.adapter.builder.StagedThemeModelAdapterBuilder" />
	<bean class="com.liferay.portal.spring.aop.ChainableMethodAdviceInjector" id="chainableMethodAdviceInjector.layoutLocalServiceStagingAdvice">
		<property name="injectCondition" value="true" />
		<property name="newChainableMethodAdvice">
			<bean class="com.liferay.portal.service.impl.LayoutLocalServiceStagingAdvice" />
		</property>
		<property name="parentChainableMethodAdvice" ref="transactionAdvice" />
	</bean>
	<bean class="com.liferay.portal.spring.aop.ChainableMethodAdviceInjector" id="chainableMethodAdviceInjector.layoutSetLocalServiceStagingAdvice">
		<property name="injectCondition" value="true" />
		<property name="newChainableMethodAdvice">
			<bean class="com.liferay.portal.service.impl.LayoutSetLocalServiceStagingAdvice" />
		</property>
		<property name="parentChainableMethodAdvice" ref="transactionAdvice" />
	</bean>
	<bean class="com.liferay.portlet.asset.model.adapter.builder.StagedAssetLinkModelAdapterBuilder" id="com.liferay.portlet.asset.model.adapter.builder.StagedAssetLinkModelAdapterBuilder" />
</beans>